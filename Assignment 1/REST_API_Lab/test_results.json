  {
    "id": "ER1",
    "test": "Search for student 999",
    "method": "GET",
    "endpoint": "/students/999",
    "body": null,
    "expected": 404,
    "actual": 404,
    "passed": true,
    "response": "{\"detail\": \"Student not found\"}"
  },
  {
    "id": "ER2",
    "test": "Age sent as text",
    "method": "POST",
    "endpoint": "/students",
    "body": {
      "name": "Bilal",
      "age": "twenty",
      "department": "CS"
    },
    "expected": 422,
    "actual": 422,
    "passed": true,
    "response": "{\"detail\": [{\"type\": \"int_parsing\", \"loc\": [\"body\", \"age\"], \"msg\": \"Input should be a valid integer, unable to parse string as an integer\", \"input\": \"twenty\"}]}"
  },
  {
    "id": "ER3",
    "test": "POST without name field",
    "method": "POST",
    "endpoint": "/students",
    "body": {
      "age": 20,
      "department": "CS"
    },
    "expected": 422,
    "actual": 422,
    "passed": true,
    "response": "{\"detail\": [{\"type\": \"missing\", \"loc\": [\"body\", \"name\"], \"msg\": \"Field required\", \"input\": {\"age\": 20, \"department\": \"CS\"}}]}"
  },
  {
    "id": "ER4",
    "test": "PUT on non-existent student 999",
    "method": "PUT",
    "endpoint": "/students/999",
    "body": {
      "name": "Ghost",
      "age": 20,
      "department": "CS"
    },
    "expected": 404,
    "actual": 404,
    "passed": true,
    "response": "{\"detail\": \"Student not found\"}"
  },
  {
    "id": "ER5",
    "test": "PATCH on non-existent student 999",
    "method": "PATCH",
    "endpoint": "/students/999",
    "body": {
      "age": 25
    },
    "expected": 404,
    "actual": 404,
    "passed": true,
    "response": "{\"detail\": \"Student not found\"}"
  },
  {
    "id": "ER6",
    "test": "PATCH with empty body {}",
    "method": "PATCH",
    "endpoint": "/students/101",
    "body": {},
    "expected": 400,
    "actual": 400,
    "passed": true,
    "response": "{\"detail\": \"Invalid or empty update fields\"}"
  },
  {
    "id": "ER7",
    "test": "PATCH with unknown field",
    "method": "PATCH",
    "endpoint": "/students/101",
    "body": {
      "cgpa": 3.5
    },
    "expected": 422,
    "actual": 422,
    "passed": true,
    "response": "{\"detail\": [{\"type\": \"extra_forbidden\", \"loc\": [\"body\", \"cgpa\"], \"msg\": \"Extra inputs are not permitted\", \"input\": 3.5}]}"
  },
  {
    "id": "ER8",
    "test": "DELETE non-existent student 999",
    "method": "DELETE",
    "endpoint": "/students/999",
    "body": null,
    "expected": 404,
    "actual": 404,
    "passed": true,
    "response": "{\"detail\": \"Student not found\"}"
  },
  {
    "id": "ER9",
    "test": "Negative age",
    "method": "POST",
    "endpoint": "/students",
    "body": {
      "name": "Usman",
      "age": -5,
      "department": "CS"
    },
    "expected": 422,
    "actual": 422,
    "passed": true,
    "response": "{\"detail\": [{\"type\": \"greater_than\", \"loc\": [\"body\", \"age\"], \"msg\": \"Input should be greater than 0\", \"input\": -5, \"ctx\": {\"gt\": 0}}]}"
  },
  {
    "id": "ER10",
    "test": "Non-integer student ID",
    "method": "GET",
    "endpoint": "/students/abc",
    "body": null,
    "expected": 422,
    "actual": 422,
    "passed": true,
    "response": "{\"detail\": [{\"type\": \"int_parsing\", \"loc\": [\"path\", \"student_id\"], \"msg\": \"Input should be a valid integer, unable to parse string as an integer\", \"input\": \"abc\"}]}"
  },
