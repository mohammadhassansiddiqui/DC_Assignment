[
  {
    "id": "E1",
    "test": "GET - retrieve all students",
    "method": "GET",
    "endpoint": "/students",
    "body": null,
    "expected": 200,
    "actual": 200,
    "passed": true,
    "response": "{\"101\": {\"name\": \"Ali\", \"age\": 20, \"department\": \"Computer Science\"}, \"102\": {\"name\": \"Sara\", \"age\": 21, \"department\": \"Information Technology\"}, \"103\": {\"name\": \"Ahmed\", \"age\": 22, \"department\": \"Software Engineering\"}}"
  },
  {
    "id": "E2",
    "test": "GET - retrieve student 101",
    "method": "GET",
    "endpoint": "/students/101",
    "body": null,
    "expected": 200,
    "actual": 200,
    "passed": true,
    "response": "{\"name\": \"Ali\", \"age\": 20, \"department\": \"Computer Science\"}"
  },
  {
    "id": "E3",
    "test": "POST - add new student Zara",
    "method": "POST",
    "endpoint": "/students",
    "body": {
      "name": "Zara",
      "age": 20,
      "department": "Artificial Intelligence"
    },
    "expected": 201,
    "actual": 201,
    "passed": true,
    "response": "{\"message\": \"Student added successfully\", \"student_id\": 104, \"student\": {\"name\": \"Zara\", \"age\": 20, \"department\": \"Artificial Intelligence\"}}"
  },
  {
    "id": "E4",
    "test": "PUT - replace student 101",
    "method": "PUT",
    "endpoint": "/students/101",
    "body": {
      "name": "Ali Khan",
      "age": 21,
      "department": "Data Science"
    },
    "expected": 200,
    "actual": 200,
    "passed": true,
    "response": "{\"message\": \"Student updated successfully\", \"student\": {\"name\": \"Ali Khan\", \"age\": 21, \"department\": \"Data Science\"}}"
  },
  {
    "id": "E5",
    "test": "PATCH - update only age of 101",
    "method": "PATCH",
    "endpoint": "/students/101",
    "body": {
      "age": 23
    },
    "expected": 200,
    "actual": 200,
    "passed": true,
    "response": "{\"message\": \"Student partially updated\", \"student\": {\"name\": \"Ali Khan\", \"age\": 23, \"department\": \"Data Science\"}}"
  },
  {
    "id": "E6",
    "test": "DELETE - remove student 104 (Zara)",
    "method": "DELETE",
    "endpoint": "/students/104",
    "body": null,
    "expected": 204,
    "actual": 204,
    "passed": true,
    "response": "(empty body)"
  },
