    "actual": 404,
    "passed": true,
    "response": "{\"detail\": \"Student not found\"}"
  },
  {
    "id": "ER2",
    "test": "POST age sent as text",
    "method": "POST",
    "endpoint": "/students",
    "body": {
      "name": "Zain",
      "age": "twenty",
      "department": "CS"
    },
    "expected": 422,
    "actual": 422,
    "passed": true,
    "response": "{\"detail\": [{\"type\": \"int_parsing\", \"loc\": [\"body\", \"age\"], \"msg\": \"Input should be a valid integer, unable to parse string as an integer\", \"input\": \"twenty\"}]}"
  },
  {
    "id": "ER3",
    "test": "POST without name field",
    "method": "POST",
    "endpoint": "/students",
    "body": {
      "age": 20,
      "department": "CS"
    },
    "expected": 422,
    "actual": 422,
    "passed": true,
    "response": "{\"detail\": [{\"type\": \"missing\", \"loc\": [\"body\", \"name\"], \"msg\": \"Field required\", \"input\": {\"age\": 20, \"department\": \"CS\"}}]}"
  },
